# ============================================================================
# Orchestra — Environment Variables
# Source of truth: Parts 5, 7, 13
# ============================================================================

# ── Runtime ──
NODE_ENV=development
API_PORT=4000
WORKER_CONCURRENCY=25

# ── Database (Supabase) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54324
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Auth ──
JWT_SECRET=local-dev-jwt-secret-change-me-please-32
ENCRYPTION_KEY=dev-encryption-key-change-me-32ch
SERVICE_TOKEN=replace-with-a-48-plus-character-random-secret
SERVICE_TOKEN_MAX_AGE_SECONDS=60

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Web ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI Service (Python model gateway — Copilot generate/refine/diagnose) ──
AI_SERVICE_URL=http://localhost:8000

# ── Provider Keys ──
OPENAI_API_KEY=replace-with-provider-secret
ANTHROPIC_API_KEY=replace-with-provider-secret
BYO_KEY_KMS_KEY_ID=orchestra-ai-byo-key

# ── OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/oauth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/oauth/microsoft/callback

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Logging ──
LOG_LEVEL=info

# ── AI Model Routes (documented; implemented in apps/ai gateway ROUTES) ──
# copilot_plan: anthropic claude-sonnet-4-5, fallback openai gpt-4.1
# Do not use `ROUTES key value` lines — Docker Compose rejects keys with spaces.
