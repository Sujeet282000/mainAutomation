# ============================================================================
# Orchestra / Algoverge — Environment Variables
#
# HOW TO USE
#   1. Copy this file:            cp .env.example .env
#   2. Fill in the values marked "required" below. Everything else is optional
#      — the app runs without them, with graceful degradation.
#   3. Restart the services:      npm run dev   (api :4000, web :3000, ai :8000)
#
# SECTIONS
#   1. Runtime & database          (required)
#   2. Auth & security             (required)
#   3. AI model providers          (at least one required — automatic failover)
#   4. One-click OAuth2 apps       (optional — per-app consent popups)
#   5. Legacy first-party OAuth    (optional — Google/Slack/GitHub/Microsoft)
#   6. Payments & misc             (optional)
# ============================================================================

# ── 1. Runtime & database ────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WORKER_CONCURRENCY=25

# Postgres (Supabase local dev default shown; required)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Supabase client (used by some storage features; optional in local dev)
SUPABASE_URL=http://localhost:54324
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# Redis (queue + scheduler; required for worker/scheduler)
REDIS_URL=redis://localhost:6379

# ── 2. Auth & security ───────────────────────────────────────────────────
# 32+ char random strings — required
JWT_SECRET=local-dev-jwt-secret-change-me-please-32
ENCRYPTION_KEY=dev-encryption-key-change-me-32ch
SERVICE_TOKEN=replace-with-a-48-plus-character-random-secret
SERVICE_TOKEN_MAX_AGE_SECONDS=60

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend → API base URL and the app's public URL (used for OAuth redirects)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 3. AI model providers — automatic failover cascade ───────────────────
# The copilot / agent gateway tries these IN ORDER until one answers:
#     OpenAI → Anthropic → Gemini → Groq → local LLM
# Configure AT LEAST ONE. If a provider returns 429 (out of credits) or 401
# (bad key), the request automatically cascades to the next one.
OPENAI_API_KEY=replace-with-provider-secret
ANTHROPIC_API_KEY=replace-with-provider-secret
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: custom base URLs (OpenAI-compatible endpoints, proxies, Azure…)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local OpenAI-compatible LLM (Ollama, vLLM, LM Studio) — final fallback
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama

# Python AI service (the model gateway the copilot talks to)
AI_SERVICE_URL=http://localhost:8000

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai
BYO_KEY_KMS_KEY_ID=orchestra-ai-byo-key

# ── 4. One-click OAuth2 apps (generic registry) ──────────────────────────
# Each app below switches from "paste your API token" to a real vendor
# consent popup once BOTH the _CLIENT_ID and _CLIENT_SECRET are set.
# Default redirect URI: <API_URL>/api/v1/oauth/<provider>/callback
#   local example → http://localhost:4000/api/v1/oauth/notion/callback
# Register each app at the vendor's developer console (docsUrl shown in the
# connect modal) and paste the client id/secret here.
#
# Notion          → https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# HubSpot         → https://developers.hubspot.com
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Salesforce      → https://developer.salesforce.com (Connected App)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# GitHub          → https://github.com/settings/developers (OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/v1/oauth/github/callback
# X (Twitter)     → https://developer.x.com (User authentication settings, PKCE)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Zoom            → https://developers.zoom.us (OAuth app)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The rest follow the same pattern — set both vars to enable one-click OAuth:
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
TYPEFORM_CLIENT_ID=
TYPEFORM_CLIENT_SECRET=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Optional: override any default redirect URI per provider
# <PROVIDER>_REDIRECT_URI=http://localhost:4000/api/v1/oauth/<provider>/callback

# ── 5. Legacy first-party OAuth (Google / Slack / Microsoft) ─────────────
# Google covers Gmail, Google Sheets, Calendar and Drive in one consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/oauth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/oauth/microsoft/callback

# ── 6. Payments & misc ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

LOG_LEVEL=info
